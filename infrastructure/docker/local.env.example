# Local Docker settings. The launcher copies this file to .env.docker.
# These credentials are for local development only.
STUDIO_PORT=3000
GENERATION_PORT=8100
RENDER_PORT=8200
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=synaptix_local
MINIO_ROOT_PASSWORD=synaptix_local_password

# Optional external SynaptixPlay backend (not included in this repository).
# Docker Desktop reaches a backend on your computer through host.docker.internal.
# SYNAPTIX_PLATFORM_API_URL=http://host.docker.internal:5080
SYNAPTIX_PLATFORM_API_URL=
# Set the matching platform service token to enable render-worker polling.
RENDER_WORKER_SERVICE_TOKEN=
# This URL is used by the browser, so use localhost, not a Docker service name.
NEXT_PUBLIC_SYNAPTIX_SIGNALR_HUB_URL=
