# Local Docker settings. The launcher copies this file to .env.docker.
# These credentials are for local development only.
STUDIO_PORT=3000
GENERATION_PORT=8100
RENDER_PORT=8200
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=synaptix_local
MINIO_ROOT_PASSWORD=synaptix_local_password

# Optional external SynaptixPlay backend (not included in this repository).
# Docker Desktop reaches a backend on your computer through host.docker.internal.
# Its development profile uses port 5100; start it with --urls http://0.0.0.0:5100.
# SYNAPTIX_PLATFORM_API_URL=http://host.docker.internal:5100
SYNAPTIX_PLATFORM_API_URL=
# Must equal the backend's ServiceTokens:RenderWorker value to enable worker polling.
RENDER_WORKER_SERVICE_TOKEN=
# Most queued-or-running render jobs one player may have (default 10; 0 = no limit).
RENDER_MAX_ACTIVE_JOBS_PER_OWNER=10
# The studio's own sign-in; must equal the backend's ServiceTokens:MusicStudio.
# Empty: SynaptixPlay sign-in is off in the studio.
SYNAPTIX_PLATFORM_SERVICE_TOKEN=
# This URL is used by the browser, so use localhost, not a Docker service name,
# and include the hub path, e.g. http://localhost:5100/ws/notify.
NEXT_PUBLIC_SYNAPTIX_SIGNALR_HUB_URL=

# Arrangement composer for the generation API: procedural (default), claude, or local.
# "claude" needs ANTHROPIC_API_KEY; any AI failure falls back to procedural with a warning.
SYNAPTIX_COMPOSER=procedural
SYNAPTIX_CLAUDE_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# Local composer (SYNAPTIX_COMPOSER=local): start the GPU model server with COMPOSE_PROFILES=local-ai,
# then download the model once: docker exec synaptix-music-ollama-1 ollama pull qwen2.5:7b
COMPOSE_PROFILES=
SYNAPTIX_LOCAL_MODEL=qwen2.5:7b

# Scoped MinIO account for the render worker (see the Stage 12 runbook). Empty = root fallback.
RENDER_WORKER_MINIO_ACCESS_KEY=
RENDER_WORKER_MINIO_SECRET_KEY=

# SynaptixPlay test player for `npm run certify:stage12:local`. Register it with
# POST http://localhost:5100/api/v1/auth/register; leave empty to be asked when running.
SYNAPTIX_CERT_EMAIL=
SYNAPTIX_CERT_PASSWORD=

# Prototype MusicGen audio (local-ai profile; CC-BY-NC weights, prototype-only output).
# Set to http://audio-generation:8400 to show the studio's Prototype audio panel.
AUDIO_GENERATION_API_URL=
MUSICGEN_MODEL=facebook/musicgen-small
