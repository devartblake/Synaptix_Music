NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GENERATION_API_URL=http://localhost:8100
# Public hub URL only. Authentication is supplied by the browser's secure session cookie.
NEXT_PUBLIC_SYNAPTIX_SIGNALR_HUB_URL=http://localhost:5100/ws/notify
SYNAPTIX_PLATFORM_API_URL=http://localhost:5100
RENDER_WORKER_SERVICE_TOKEN=replace-with-a-dedicated-service-token
RENDER_WORKER_API_URL=http://localhost:8200
RENDER_WORKER_MINIO_ENDPOINT=localhost
RENDER_WORKER_MINIO_PORT=9000
RENDER_WORKER_MINIO_USE_SSL=false
RENDER_WORKER_MINIO_ACCESS_KEY=synaptix_render_worker
RENDER_WORKER_MINIO_SECRET_KEY=replace-with-a-dedicated-secret
RENDER_WORKER_MINIO_BUCKET=synaptix-assets
RENDER_WORKER_SIGNED_URL_TTL_SECONDS=900
RENDER_WORKER_FFMPEG_PATH=ffmpeg
# Staging-only inputs for `npm run certify:stage12` (never commit real values).
STAGE12_CERT_PROJECT_ID=
STAGE12_CERT_REVISION_ID=
STAGE12_CERT_PROJECT_CHECKSUM_SHA256=
STAGE12_CERT_OUTPUT_FORMAT=ogg
STAGE12_CERT_REPORT_PATH=stage12-certification-report.json
DATABASE_URL=postgresql://synaptix:synaptix@localhost:5432/synaptix_music
REDIS_URL=redis://localhost:6379/0
